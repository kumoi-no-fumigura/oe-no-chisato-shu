  {
   "id": "nijl-oe-no-chisato-shu-0017",
   "pid": "nijl-200020037",
   "pages": [
    17
   ],
   "text": "古今恋二同十一日ねに時きてこちにして春面にぬれにし袖とゝはゝこたんもみちはを風にまかせてみるよろもはかなきものは顔なりけり",
   "poems": [
    "131",
    "132"
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "山たかみふりくる霧にむすれはや鳴鴬の声すれになる",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "咽霧山鶯啼尚少",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "鶯のなきつる声にさそはれて花のもとにそわれはきにけり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一鶯声誘引来花下",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "しつかなゝときを尋ねていつこにか花のありかをそもに",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "一偸閑何処無尋無尋無別異"
  },
  {
   "seq": "4",
   "text": "花の枝をりつかかこにちりまかふ匂ひのあかにおもほゆる哉",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一花枝拳虚芽紛之",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "一神さけてふりぬる里に住人はみやこに匂ふ花をたにみ方",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不見洛陽花",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "今ははやかへりきなまし道なりし花をみまに程そへにける",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "晩帰多是省花廻",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "こつたひて線の糸のよりけれはうくひわゝとつるちからたになし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "緑竹枝弱不勝鴬",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "花をのみ尋こましに春はまたふかきあさきもしられたり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "尋花不問春浅深",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "はかなくて所々なる風のとしをへて春吹おはることそあやしに",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜風吹送毎年春",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "あたゝけき春の山へのみなのみそところもわかに咲みたれける",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春暖山花庵之開",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "あとたえてしつけき山にさく花のちりはくるまてみるひとも",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落炎閑花不見人",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "としふかく老ぬる人のかなしさはさける花さへおとる也けて",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "老眼花前晴",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "花をみてかへらんことを出するゝは色こき花によりて也けり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花下忠帰同美景",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "年月にまさるときなしとおもへはやはるしもつねにすくならん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳時春猶少",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "あたのみ過ゆく春を以かてかはこゝろをいれてをしまさるへき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "送春那潟不慇懃",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "かねてより和かおしべし春はたゝあけんあしそかなり成へき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "〃春光只是有明朝",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "春をのみこゝをからこもおしめるもみなをなしきつさぬるかしき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "両虚春光同日豊",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "はる〳〵とおひて老ぬる身なれはやゑひになものあかれならん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "本春翁酒易書",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "あつれとも和か身のみそそそおほゆれはかな春をすくしぬれは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "本春翁酒易書",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "なけなつゝすきゆく春をおしめとも言つ真かしふりそつし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一帆帳春帰不留得",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "ひとらせにまたふたゝひとこぬものをたゝひるなるそ春はみて",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一歳唯残半日春",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "このめはるさかひこしえたははなのかけなりまさりけ",
   "kana": "",
   "speaker": "のこれる",
   "page": 6,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春條長定夏陰盛",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "うくひすはすきにし春をおしみつゝなく戸おほきころにそ",
   "kana": "",
   "speaker": "なりまさつける",
   "page": 6,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鶯多過春語",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "うつせみの身とし給りぬるものなりは秋をまたてそなさぬへらなる",
   "kana": "",
   "speaker": "有ける",
   "page": 6,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "蝉不待秋鳴",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "うくひすはときならねはやなく声の今はまれにそなりぬくらなる",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鶯語漸之稀",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "ちかまかふ花は木のはにかたられて稀ににほへかかせそとも",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一余花葉裡櫛",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "かたりとて春の過にしときよりそなくみりのねのいたしこゆる",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春巻啼鳥廻",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "あきはちにひらくる水の上にくれなゐふかき色にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "蓮開水上紅",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "ふく風に枝もむなしくなりゆけはおほかはなこそまれに",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "枝虫花落稀",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "なく鳥の声ふかくのみきこゆるはのこれるはなのえたをわふるか",
   "kana": "",
   "speaker": "見えけれ",
   "page": 7,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鳥思残花枝",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "月かけになへてまさこのてりぬれはなつのよふかく霜ことそ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月照平沙夏夜霜",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "我こゝろしつけきときはふく風の身にかはらねとすゞしける",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "但能心静即身涼",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "山たかみたにを和けつゝゆく水はふきくる風にすゝしける",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "潤洞路甚清涼",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "あまの川つゝのはるかになりゆけはあひみんものうためなき",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "天漢過々不可期",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "酢のよのしもにたとへて我かみはとしのはかなくをひしつられは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋霜鬢似年空長",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "おほかたの秋来るかゝに和か身こそかなしきものとおもひの",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋来只識此身哀",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "をく霜に学のかれゆくときよりそなくむしのねも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霜草多枯虫思花",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "一とせにたたよひこそたなはたのあまのかはらをわたるとになれ",
   "kana": "",
   "speaker": "たかくきゆる",
   "page": 8,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一今宵職女渡天河",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "ものをおもふこゝろの秋に給りぬれはすへて今そみえわたりと",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "心緒逢秋一似秋",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "〽おほうたの秋をなし見ることにあたなる人からすそありける",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一百二十二人心",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "常よりも秋の木のはに近〳〵霜のくれなゐふかく見ゆかころな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一同十同同",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "かすかなるときのみこゆるあきしのはものおもふことらそかりかりける",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "蕭條秋思苦",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "すきてゆく秋のかなしく登つるは老なんものおしき也けり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恐秋へ多老",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "もみちつたりくれなゐにみゆる日はなく蝉さへせなくは也ぬる",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅樹蝉鳴",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "秋のよをさむみなきつかむしの音和か宿にこそあましけか",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅樹蝉鳴",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "ゆくかりの秋のすきかたにひとりしもともにおくれて侍わたるらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅樹蝉鳴",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "ふゝ風のをとたかくさへきゆれはをく霞さへもさむら有かな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅樹蝉鳴",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "木のはみなかゝくれ給ゐにしくるうてしものさたにもをきまさかな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅樹蝉鳴",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "秋のよほさむとなきつゝゆくかりのしもをしもをゆきかへけらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅樹蝉鳴",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "しのゝめに秋をく露のさむけれはたゝ日とりしもむしのなくに",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅樹蝉鳴",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "秋すきはちかなんこのをなく鳥のまつ紅葉の枝にしもな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鳥栖紅葉樹",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "秋のよをかつはなきつされとまつことつてはみゆるなかか",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋雁過尽無書到",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "行うりのとふことはやくみえしりあきはかきりとおもひなりによ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒雁飛",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "なく雁の声人にたえてきこえねはたひなる人をおもひまさりぬ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒雁声静客怨至",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "鳴せみの声たかくのみきこゆれはあきすむむしの秋うしかたし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒雁声静客怨至",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "いつしかと冬をむかふかあしたうらまつよき風のふくうなしき",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "迎冬光有好風",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "さよめて猶ねられねは春風のふきつるかともおもほゆるなり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "中雪似有春風至",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "一年にはるくるとは今そしくぬしをきそれとあかしかたきに",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一年冬至夜偏長",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "あるしきうれへとおう〳〵さむきよのなかきよりそはめ也けれ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "新愁夕侍夜長来",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "ものをおもふこゝろも灰とくたるゝあつきにはをかみさりける",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "炭不攻燵中火",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "和かみのみならゆきとなりゆけはをけるしもともおとろかれけり",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鬢雪多猶砌下霜",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "とし〳〵とかけへこしまにはかなくて人は老ぬるものにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "年々只是人真老",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "あたまてにみてかさけそさむきよは人の身まてにあたゝまりけれ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十分一盞暖於人",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "老てぬるあはゝやさめてとこしなへよくにすはれけねをのみなく",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "老眠早覚常残夜",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "よひ〳〵にまたをく霜のさむけれはくさはをたにそからせさまる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霜未数毒々草",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "ひとりゐてもゆるほたるにむかへみやかくやるなきみとり也ぬる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霜未数毒々草",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "かくはかり老ぬとおもへは今さらにひかりのちくることもおほえす",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "長年老不惜光陰",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "をきへより吹来る風はしらなみのはなとのみこそ見立わたりけれ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "風翻白浪花千片",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "て日月はなみのこゝろに飛かされてひとつかたにもみえわたかな",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一月照波心一題珠",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "わひてふるほとにもかりのくれゆけはふく風のみそとさしなりける",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一架扉日暮随風掩",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "天皇もをすくもりもはてぬ春の上のおほろ月よめてた",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不明不暗朧之月",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "かさゝきのみねとひこえてなきゆけ八みやまかくるし月かとそみる",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鵲花山月曙",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "雲はれてよき月うけもつねならにあらんかなりはおしみかそすれ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "清景難逢",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "あつからにさむるもあらすよきほとに吹来る風はやますもあらなん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "非暖非寒漫々風",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "ふたつとものえぬを月の山ことにてりわたりつゝあきらけきかな",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残月照山朝",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "さためなくなきくる風はおきわけてなとてなとからけきに人につくらむ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "風索属同人",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "て日月のみやこはかりはありこ人とたはねてゆかんほとしられぬ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月言有語無思人",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "をしみてもとめまほしきをはる風のふきすきたくなりぬとおりへは",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "可憐春風老",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "雲もなくたには山さへはれいけはみつのいろこそあたなりけれ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山雲初晴水色新",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "しら雲のなりをわけつく遊ふくれのめてたきことは山にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一猶愛雲容多在山",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "とひし葉て雲のかけはしとひゆかむいつれのかたか山はさかしき",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "借問春山何処高",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "ゆく水のあをき山よりおちくれはしら雲からそみえまかひつる",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "借問春山何処高",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "よ所にても花をあはれとおほとにしらぬやまにそわれはきにけり",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "遥見人寇見人家花便人"
  },
  {
   "seq": "84",
   "text": "さしわけてふかくあはれと冬つるははれてしつけきなりけりけり",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "可憐悲静地",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "かけしけきみつのあたりそとしをへてすゝきぬれともみえすなける",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "井下水頭無秋白",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "ふく風のひかりをとめんとおり人はそしはしはして春にあそふへら",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一歓偸風索撃背",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "あやなくもとしのをなかゝひけりしてあくかれわたる身はやなりなりなん",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "長作独遊人",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "一天づそらちかく発つく其へばるいかれゆく山のふもと也けり",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "天高暮山遠",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "かさりとて野人のはるかに見えつれはたつし雪もふろくそ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野曠白雲深",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "山ことに花のにしきををのはこそみゆるところのやすき所りなき",
   "kana": "",
   "speaker": "ありける",
   "page": 13,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山花織錦無縁",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "たに水のことのねたえすさけれはときのまをたにへたて又夕",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山花織錦無縁",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "なくなみた乗るたとにかゝりてはくれなゐふりきあやとこそみれ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一同三百成文",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "わかわかしいひつるときははる家をちかきをみぬそこひしける",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "別無遠近皆難見",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "ちかたぬときにひとたむわかかれははぬもとせそへたゝりにけ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "悠々一別巳三年",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "わかれにし君を聞ひてたつぬれは遊めのたましひはかけ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "前後相思夢魂遠",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "わかれにし君にみせにていたつゝにかたちのかはり身こそつらけれ",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "前後愛惜客花改",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "しら雲のわかることにたちつれときみなたにこそゆきかくれぬれ",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "白雲一片随君去",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "わかれての後も見えとおもへともこれをいつぬのときとかはみち",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "後時相見是何時",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "人をくるともにはるさへ過ぬれはこれにうらみはあまりなりけり",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "送故辞春過恨多",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "ちかくすはるけきほとにとしをへてひてひとりある人御ゝろしかりけり",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "万里経年別",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "わかれそののちはしらぬをいかならんときにか又はあはんとすらん",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不知何日又相逢",
   "kotobagaki": ""
  },
  {
   "seq": "102",
   "text": "ものをそくものをそおもふありてのみわかりとをおもふわり身は",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "既吟雑別情",
   "kotobagaki": ""
  },
  {
   "seq": "103",
   "text": "さためなきこゝろひとつをなしつるもいのちをのふるもの",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "自静其心延寿命",
   "kotobagaki": ""
  },
  {
   "seq": "104",
   "text": "世中をおもひしりぬるこゝろそ身よりはすきて老まさりけれ",
   "kana": "",
   "speaker": "にそありける",
   "page": 14,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "心更老身",
   "kotobagaki": ""
  },
  {
   "seq": "105",
   "text": "こゝろをしあまのうき木になしつれはなかるゝ水にこゝろに",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "心更老身",
   "kotobagaki": ""
  },
  {
   "seq": "106",
   "text": "はかなくていつも我身のひとりしてあしたゆふへにしつ心なき",
   "kana": "",
   "speaker": "一まされり",
   "page": 15,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "何独朝々暮々困",
   "kotobagaki": ""
  },
  {
   "seq": "107",
   "text": "よるへなく所ごにうかへかこゝろこそ遊め見るよりもはかなかり",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浮生短於夢",
   "kotobagaki": ""
  },
  {
   "seq": "108",
   "text": "かなしきもうれしきもおほかるをこゝろひとつうなさつかりける",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一慶喜御同心灰",
   "kotobagaki": ""
  },
  {
   "seq": "109",
   "text": "わか身をはうかへる雲になされはそゆたたもなくはかなかりとり",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "自違浮雲無所著",
   "kotobagaki": ""
  },
  {
   "seq": "110",
   "text": "方ほろしの世とししりぬるこゝろにはかなき夢とおかひなりけり",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "幻世去来夢",
   "kotobagaki": ""
  },
  {
   "seq": "111",
   "text": "かりそめにし新うかへるたまひしのみつのあはともたとへられ",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浮生水上酒",
   "kotobagaki": ""
  },
  {
   "seq": "112",
   "text": "くろかみのしろく光かになりぬれははるのはなとそ見えわたり",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "素鬢俄仮変春花",
   "kotobagaki": ""
  },
  {
   "seq": "113",
   "text": "わかきみもはるのひかりにひとしくはさきなか身ともしりぬ",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恩光春栄去",
   "kotobagaki": ""
  },
  {
   "seq": "114",
   "text": "遊めにてもうれしきときをみるときはこゝにちりくる身には",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夢中観楽又縁愁",
   "kotobagaki": ""
  },
  {
   "seq": "115",
   "text": "しかわけてみやこたつねにくる雁も春にあひてはとひかへりけり",
   "kana": "",
   "speaker": "まされり",
   "page": 15,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "詠懐",
   "kotobagaki": ""
  },
  {
   "seq": "116",
   "text": "はることにあひて意あらぬわか身かな花の雪のみふりまかひつく",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "詠懐",
   "kotobagaki": ""
  },
  {
   "seq": "117",
   "text": "春のみやはなはさくらむたにさむみうつかるへさはひかり”丸す",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "詠懐",
   "kotobagaki": ""
  },
  {
   "seq": "118",
   "text": "しら浪のたちかへりくるかすよりも我身をなけへ其はまされり",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "詠懐",
   "kotobagaki": ""
  },
  {
   "seq": "119",
   "text": "あしたつのひとりおはれて鳴声は雲のたへまてきこえつかなん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "詠懐",
   "kotobagaki": ""
  },
  {
   "seq": "120",
   "text": "しまゝもや身をかくすらん日のひかり我身てらせと見るよして",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "詠懐",
   "kotobagaki": ""
  },
  {
   "seq": "121",
   "text": "とにもにはるあきのみをかかへつゝ身はひとゝきにあふかしなし",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "詠懐",
   "kotobagaki": ""
  },
  {
   "seq": "122",
   "text": "おもふことなく鶯につけたれはいろもかはらぬわれひとりてへ契首",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "詠懐",
   "kotobagaki": ""
  },
  {
   "seq": "123",
   "text": "都まてなみたちともきかなくにしろしくになと身のしつむらん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "詠懐",
   "kotobagaki": ""
  },
  {
   "seq": "124",
   "text": "一続古春下あはれとはツミのみ社曽の下句同千里とあり",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "詠懐",
   "kotobagaki": ""
  },
  {
   "seq": "125",
   "text": "ほともさすさつきまたすそなねける老かなく春をすくしは",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "詠懐",
   "kotobagaki": ""
  },
  {
   "seq": "126",
   "text": "鶯の谷よりいへる声なくは春くることをたれかしらまし",
   "kana": "",
   "speaker": "槐藤判",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "本云一同年比本為忠卿之筆分明也亜一雖入撰集不見家集寄"
  },
  {
   "seq": "127",
   "text": "やとりせしはなたちは我もかれなくになと郭公声たらぬ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "128",
   "text": "月みれはちゝにものこそかなしけれ我身ひとつの秋にはあらねと",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "129",
   "text": "うゑしとき花まちと内に有し菊梅ふ秋にあはんとやみし",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "130",
   "text": "のあまきのおだれて生るなへまれとあたにかならぬたのみとそさく",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "131",
   "text": "ねに時きてこちにして春面にぬれにし袖とゝはゝこたん",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "132",
   "text": "もみちはを風にまかせてみるよろもはかなきものは顔なりけり",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nijl-200020037",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  }
 ],
